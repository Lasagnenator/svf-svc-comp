# Purpose of this file is to demonstrate that you need a authorized_keys file
# DO NOT EDIT THIS FILE. This is a placeholder only
# "authorized_keys" is already gitignored. 
# To set up your own SSH access:
#   1. Generate a key (skip if you already have one):
#      ssh-keygen -t ed25519 -C "your_email@example.com"
#   2. Create your own authorized_keys file with your public key.
#      cat ~/.ssh/id_ed25519.pub > authorized_keys
#
ssh-ed25519 REPLACE_WITH_YOUR_OWN_PUBLIC_KEY your_email@example.com
